table Targets
	lineageTag: 2d537fad-3f6e-4f45-9bbb-c3c32b929926

	column MonthStart
		dataType: dateTime
		formatString: Long Date
		lineageTag: 4b5cb7ec-1a74-457a-9810-c2c695882562
		summarizeBy: none
		sourceColumn: MonthStart

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Category
		dataType: string
		lineageTag: 265de058-5461-4f6e-a43d-54c3b7a3a850
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column TargetRevenueUSD
		dataType: double
		formatString: 0
		lineageTag: be2a9de4-1bdb-43ef-84ad-4d2bf8fcf65c
		summarizeBy: sum
		sourceColumn: TargetRevenueUSD

		annotation SummarizationSetBy = Automatic

	partition Targets = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Targets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"MonthStart", type date}, {"Category", type text}, {"TargetRevenueUSD", type number}}, "en-US")
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

