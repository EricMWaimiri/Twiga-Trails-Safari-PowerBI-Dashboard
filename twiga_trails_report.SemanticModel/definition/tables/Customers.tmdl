	partition Customers = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "Customers.xlsx"), null, true),
				    Sheet = Source{[Item = "Customers", Kind = "Sheet"]}[Data],
				    SkippedTitleRows = Table.Skip(Sheet, 2),
				    PromotedHeaders = Table.PromoteHeaders(SkippedTitleRows, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {
				        {"CustomerID", type text}, {"FirstName", type text}, {"LastName", type text},
				        {"Country", type text}, {"Segment", type text}, {"AgeBand", type text},
				        {"JoinDate", type date}
				    }, "en-US"),
				    TrimmedCountry = Table.TransformColumns(ChangedTypes, {{"Country", Text.Trim, type text}}),
				    CountryFixes = {
				        {"USA", "United States"}, {"U.S.A.", "United States"}, {"usa", "United States"},
				        {"United States of America", "United States"},
				        {"UK", "United Kingdom"}, {"U.K.", "United Kingdom"},
				        {"Great Britain", "United Kingdom"}, {"UAE", "United Arab Emirates"},
				        {"The Netherlands", "Netherlands"}, {"Holland", "Netherlands"},
				        {"germany", "Germany"}, {"Deutschland", "Germany"}
				    },
				    StandardisedCountry = List.Accumulate(CountryFixes, TrimmedCountry, (TableState, Pair) =>
				        Table.ReplaceValue(TableState, Pair{0}, Pair{1}, Replacer.ReplaceValue, {"Country"})),
				    AddedFullName = Table.AddColumn(StandardisedCountry, "FullName", each [FirstName] & " " & [LastName], type text)
				in
				    AddedFullName

	annotation PBI_ResultType = Table

