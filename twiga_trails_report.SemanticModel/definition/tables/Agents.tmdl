	partition Agents = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Agents.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"AgentID", type text}, {"AgentName", type text}, {"Channel", type text}, {"BaseCountry", type text}, {"CommissionPct", type number}}, "en-US")
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

