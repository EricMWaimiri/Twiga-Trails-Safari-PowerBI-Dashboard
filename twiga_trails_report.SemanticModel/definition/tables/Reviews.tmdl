	partition Reviews = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Reviews.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"ReviewID", type text}, {"BookingID", type text}, {"ReviewDate", type date}, {"Rating", Int64.Type}, {"NPSScore", Int64.Type}, {"ReviewText", type text}}, "en-US")
				in
				    ChangedTypes

	annotation PBI_ResultType = Table

